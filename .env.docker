# Docker Environment Configuration Template
# Copy this file and fill in your actual values
# The DATABASE_URL is already configured in docker-compose.yml

# ==============================================
# EMAIL SERVICE (REQUIRED)
# ==============================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Optional: Set a specific recipient email for testing
# If not set, emails will be sent to the contact form submitter
# RESEND_RECIPIENT_EMAIL=your-verified-email@example.com


# ==============================================
# ADMIN PANEL AUTHENTICATION (REQUIRED)
# ==============================================
# Generate bcrypt hash for admin password:
# Node.js: const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your-password', 10));
# Online: https://bcrypt-generator.com/
ADMIN_PASSWORD_HASH=$2a$10$YourBcryptHashedPasswordGoesHere

# Generate a random secret (minimum 32 characters):
# Node.js: require('crypto').randomBytes(32).toString('hex')
# Linux/Mac: openssl rand -hex 32
# Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
ADMIN_SESSION_SECRET=your_random_secret_string_minimum_32_characters


# ==============================================
# CLOUDFLARE TURNSTILE (OPTIONAL)
# ==============================================
# For bot protection on contact form
# Get keys from: https://dash.cloudflare.com/
# Site key (visible to frontend)
NEXT_PUBLIC_TURNSTILE_SITEKEY=your_turnstile_site_key

# Secret key (backend only)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key


# ==============================================
# DATABASE (AUTO-CONFIGURED)
# ==============================================
# This is automatically set in docker-compose.yml
# No need to modify unless using external database
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/toptier


# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
# 1. Copy this file: cp .env.docker .env.docker.local
# 2. Fill in all REQUIRED values above
# 3. Run: docker-compose up -d
# 4. Access app at: http://localhost:3000
# 5. Access pgAdmin at: http://localhost:5050 (if using --profile tools)
#
# IMPORTANT: Never commit .env.docker.local to version control!
